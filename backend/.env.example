# Backend (local dev, outside Docker). docker-compose sets its own values.
PORT=5006
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgres://minut:minut@localhost:5432/minut
DATABASE_URL_TEST=postgres://minut:minut@localhost:5432/minut_test
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
JWT_EXPIRES_IN=1h
# Comma separated list of allowed browser origins (the Next.js app)
CORS_ORIGINS=http://localhost:3000
# Seeded on first boot if the users table is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
VIEWER_EMAIL=viewer@example.com
VIEWER_PASSWORD=viewer1234
