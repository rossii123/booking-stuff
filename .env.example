# Copy to .env to override docker-compose defaults. Everything has a working
# default for local development; ONLY the defaults below are unsafe for production.
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
JWT_EXPIRES_IN=1h
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
VIEWER_EMAIL=viewer@example.com
VIEWER_PASSWORD=viewer1234
# Set to true when the app is served over https
SESSION_COOKIE_SECURE=false
